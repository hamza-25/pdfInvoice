<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invoice Generator Pro</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts: Inter & Roboto Slab -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@400;700&display=swap" rel="stylesheet">


    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f0f2f5; /* A slightly cooler grey */
        }

        .gradient-text {
            background-image: linear-gradient(to right, #434d5f, #2d3748);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .invoice-input {
            background-color: #ffffff;
            border: 1px solid #e2e8f0;
            transition: all 0.3s ease;
        }
        .invoice-input:focus {
            box-shadow: 0 0 0 3px rgba(66, 153, 225, 0.4);
            border-color: #4299e1; /* A professional blue */
        }

        /* Visible focus ring for keyboard navigation (WCAG 2.4.7) */
        .invoice-input:focus-visible,
        button:focus-visible {
            outline: 2px solid #2563eb;
            outline-offset: 2px;
        }

        #notification-toast {
             transition: opacity 0.3s, transform 0.3s;
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800">

    <div class="container mx-auto p-4 lg:p-8">
        <!-- Header Section -->
        <header class="text-center mb-10">
            <h1 class="text-4xl md:text-5xl font-extrabold gradient-text">Professional Document Builder</h1>
            <p class="text-slate-500 mt-3 text-base md:text-lg">Fill the form to generate your document.</p>
        </header>

        <!-- Main Content Area: Form -->
        <div class="max-w-4xl mx-auto">
            <form id="invoice-form" class="bg-white p-6 md:p-8 rounded-2xl shadow-lg">
                 <!-- Invoice Type -->
                <section class="mb-8">
                    <h3 class="text-lg font-semibold text-slate-700 mb-2">Document Type</h3>
                    <label for="invoice-type" class="sr-only">Document type</label>
                    <select id="invoice-type" class="w-full p-2.5 rounded-md invoice-input">
                        <option value="SERVICE INVOICE">Service Invoice</option>
                        <option value="PRODUCT INVOICE">Product Invoice</option>
                        <option value="QUOTE">Quote</option>
                        <option value="RECEIPT">Receipt</option>
                    </select>
                </section>
                
                <!-- Company and Client Details -->
                <section class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6 mb-8">
                    <div>
                        <h3 class="text-lg font-semibold text-slate-700 mb-2">From</h3>
                        <label for="company-name" class="sr-only">Company name</label>
                        <input id="company-name" type="text" placeholder="Your Company Name" required class="w-full p-2.5 rounded-md invoice-input">
                        <label for="company-address" class="sr-only">Company address</label>
                        <textarea id="company-address" placeholder="Your Address..." class="w-full p-2.5 mt-2 rounded-md invoice-input" rows="2"></textarea>
                        <label for="company-phone" class="sr-only">Company phone</label>
                        <input id="company-phone" type="text" placeholder="Your Company phone" class="w-full p-2.5 rounded-md invoice-input">
                        <label for="company-city" class="sr-only">Company city</label>
                        <input id="company-city" type="text" placeholder="Your company city" class="w-full p-2.5 rounded-md invoice-input">
                        <label for="company-email" class="sr-only">Company email</label>
                        <input id="company-email" type="text" placeholder="Your company email" class="w-full p-2.5 rounded-md invoice-input">
                    </div>
                    <div>
                        <h3 class="text-lg font-semibold text-slate-700 mb-2">Bill To</h3>
                        <label for="client-name" class="sr-only">Client name</label>
                        <input id="client-name" type="text" placeholder="Client's Company Name" required class="w-full p-2.5 rounded-md invoice-input">
                        <label for="client-address" class="sr-only">Client address</label>
                        <textarea id="client-address" placeholder="Client's Address..." class="w-full p-2.5 mt-2 rounded-md invoice-input" rows="2"></textarea>
                        <label for="client-phone" class="sr-only">Client phone</label>
                        <input id="client-phone" type="text" placeholder="Your client phone" class="w-full p-2.5 rounded-md invoice-input">
                        <label for="client-city" class="sr-only">Client city</label>
                        <input id="client-city" type="text" placeholder="Your client city" class="w-full p-2.5 rounded-md invoice-input">
                        <label for="client-email" class="sr-only">Client email</label>
                        <input id="client-email" type="text" placeholder="Your client email" class="w-full p-2.5 rounded-md invoice-input">
                    </div>
                </section>

                <!-- Invoice Metadata -->
                <section class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
                    <div>
                        <label for="invoice-date" class="block text-sm font-medium text-slate-500 mb-1">Date</label>
                        <input id="invoice-date" type="date" required class="w-full p-2.5 rounded-md invoice-input text-slate-500">
                    </div>
                    <div>
                        <label for="due-date" class="block text-sm font-medium text-slate-500 mb-1">Due Date</label>
                        <input id="due-date" type="date" class="w-full p-2.5 rounded-md invoice-input text-slate-500">
                    </div>
                    <div>
                        <label for="currency" class="block text-sm font-medium text-slate-500 mb-1">Currency</label>
                        <select name="" id="currency" required class="w-full p-2.5 rounded-md invoice-input">
                            <option value="$">USD</option>
                            <option value="dh">MAD</option>
                            <option value="€">EUR</option>
                            <option value="¥">JPY</option>
                            <option value="£">GBP</option>
                        </select>
                    </div>
                </section>

                <!-- Invoice Items Table -->
                <section class="mb-8">
                    <h3 class="text-lg font-semibold text-slate-700 mb-2">Items (max: 15)</h3>
                    <div class="overflow-x-auto">
                        <table class="w-full">
                            <thead class="border-b">
                                <tr class="text-sm text-slate-600">
                                    <th class="p-2 font-semibold w-1/2 text-left">Description</th>
                                    <th class="p-2 font-semibold w-1/6 text-center">Qty</th>
                                    <th class="p-2 font-semibold w-1/4 text-center">Price</th>
                                    <th class="p-2"><span class="sr-only">Actions</span></th>
                                </tr>
                            </thead>
                            <tbody id="invoice-items"></tbody>
                        </table>
                    </div>
                    <div class="mt-4 flex items-center gap-3">
                        <button type="button" id="add-item-btn" class="text-blue-600 hover:text-blue-800 font-semibold flex items-center disabled:opacity-50 disabled:cursor-not-allowed">
                            <svg class="w-5 h-5 mr-1" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
                            Add Item
                        </button>
                        <span id="items-limit-hint" class="hidden text-sm text-amber-600">Maximum of 15 items reached.</span>
                    </div>
                </section>
                
                 <!-- Totals Section -->
                <section class="flex justify-end mb-8">
                     <div class="w-full max-w-xs space-y-2">
                            <div class="flex justify-between text-slate-600">
                                <span>Subtotal</span>
                                <span id="subtotal">$0.00</span>
                            </div>
                            <div class="flex justify-between items-center text-slate-600">
                                <label for="tax-rate">Tax (%)</label>
                                <input id="tax-rate" type="number" value="0" min="0" max="100" required class="w-20 p-1 text-right rounded-md invoice-input">
                            </div>
                            <hr class="border-slate-300">
                            <div class="flex justify-between font-bold text-xl text-slate-800"><span class="">Total</span><span id="total-amount">$0.00</span></div>
                        </div>
                </section>

                 <!-- Payment and Notes -->
                <section class="grid grid-cols-1 md:grid-cols-2 gap-x-8">
                    <div>
                        <h3 class="text-lg font-semibold text-slate-700 mb-2">Payment Type</h3>
                        <label for="payment-type" class="sr-only">Payment type</label>
                        <textarea id="payment-type" placeholder="e.g., Bank Transfer, Credit Card, Net 30" class="w-full p-2.5 rounded-md invoice-input" rows="4"></textarea>
                    </div>
                     <div>
                        <h3 class="text-lg font-semibold text-slate-700 mb-2">Notes</h3>
                        <label for="notes" class="sr-only">Notes</label>
                        <textarea id="notes" placeholder="Thank you for your business!" class="w-full p-2.5 rounded-md invoice-input" rows="4"></textarea>
                    </div>
                </section>

                <!-- Submit Button -->
                <section class="text-center mt-10">
                    <button id="submit-btn" class="bg-blue-600 text-white font-bold py-3 px-10 rounded-lg text-lg hover:bg-blue-700 transition-colors">
                        Submit for Processing
                    </button>
                </section>
            </form>
        </div>
    </div>
    
    <div id="notification-toast" role="status" aria-live="polite" class="fixed top-5 right-5 bg-green-600 text-white py-3 px-6 rounded-lg shadow-lg opacity-0 transform -translate-y-2">
        data sent
    </div>
     <div id="notification-toast-error" role="alert" aria-live="assertive" class="fixed top-5 left-5 bg-red-600 text-white py-3 px-6 rounded-lg shadow-lg whitespace-pre-line opacity-0 transform -translate-y-2">
        Something went wrong, please try again.
    </div>

     <script>
        document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('invoice-form');
        const addItemBtn = document.getElementById('add-item-btn');
        const invoiceItemsContainer = document.getElementById('invoice-items');
        const submitBtn = document.getElementById('submit-btn');
        const selectTags = document.getElementById('currency');



        // --- Totals state + rendering (single source of truth) ---
        let subtotalNumber = 0;
        let totalNumber = 0;

        const renderTotals = () => {
            const symbol = selectTags.value;
            document.getElementById('subtotal').textContent = `${symbol}${subtotalNumber.toFixed(2)}`;
            document.getElementById('total-amount').textContent = `${symbol}${totalNumber.toFixed(2)}`;
        };

        selectTags.addEventListener('change', renderTotals);

        // --- Core Functions ---
        const MAX_ITEMS = 15;

        const updateAddItemState = () => {
            const atLimit = document.querySelectorAll('.item-row').length >= MAX_ITEMS;
            addItemBtn.disabled = atLimit;
            addItemBtn.classList.toggle('opacity-50', atLimit);
            document.getElementById('items-limit-hint').classList.toggle('hidden', !atLimit);
        };

        const addNewItem = () => {
            if (document.querySelectorAll('.item-row').length >= MAX_ITEMS) return;
            const itemRow = document.createElement('tr');
            itemRow.classList.add('item-row');
            itemRow.innerHTML = `
                <td class="p-2"><input type="text" placeholder="Item description" maxlength="54" aria-label="Item description" class="description w-full p-2 rounded-md invoice-input"></td>
                <td class="p-2"><input type="number" value="1" min="1" aria-label="Quantity" class="quantity w-full p-2 text-center rounded-md invoice-input"></td>
                <td class="p-2"><input type="number" value="0.00" min="0" step="0.01" aria-label="Price" class="price w-full p-2 text-center rounded-md invoice-input"></td>
                <td class="p-2 text-center">
                    <button type="button" aria-label="Remove item" class="remove-item-btn text-slate-400 hover:text-red-500 transition-colors">
                        <svg class="w-5 h-5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                    </button>
                </td>
            `;
            invoiceItemsContainer.appendChild(itemRow);
            updateTotals(); // Call updateTotals after adding
            updateAddItemState();
        };

        const updateTotals = () => {
            let subtotal = 0;
            document.querySelectorAll('.item-row').forEach(row => {
                const qty = parseFloat(row.querySelector('.quantity').value) || 0;
                const price = parseFloat(row.querySelector('.price').value) || 0;
                subtotal += qty * price;
            });

            const taxRate = parseFloat(document.getElementById('tax-rate').value) || 0;
            const taxAmount = subtotal * (taxRate / 100);

            subtotalNumber = subtotal;
            totalNumber = subtotal + taxAmount;

            renderTotals();
        };

        // --- Event Listeners ---
        form.addEventListener('input', (e) => {
             // Update totals on any input change within the form
            if(e.target.matches('.quantity, .price, #tax-rate')) {
                updateTotals();
            }
        });
        
        addItemBtn.addEventListener('click', addNewItem);



        invoiceItemsContainer.addEventListener('click', (e) => {
            if (e.target.closest('.remove-item-btn')) {
                e.target.closest('.item-row').remove();
                updateTotals(); // Call updateTotals after removing
                updateAddItemState();
            }
        });

        form.addEventListener('submit', (e) => {
            e.preventDefault(); // stop native form submission (page navigation)
            submitBtn.textContent = 'Processing...';
            submitBtn.disabled = true;
            submitBtn.setAttribute('aria-busy', 'true');

            const invoiceData = {
                documentType: document.getElementById('invoice-type').value,
                company: { name: document.getElementById('company-name').value, address: document.getElementById('company-address').value,
                phone: document.getElementById('company-phone').value, city: document.getElementById('company-city').value, email: document.getElementById('company-email').value},
                client: { name: document.getElementById('client-name').value, address: document.getElementById('client-address').value, 
                phone: document.getElementById('client-phone').value, city: document.getElementById('client-city').value, email: document.getElementById('client-email').value},
                issueDate: document.getElementById('invoice-date').value,
                dueDate: document.getElementById('due-date').value,
                items: [],
                paymentType: document.getElementById('payment-type').value,
                notes: document.getElementById('notes').value,
                taxRate: parseFloat(document.getElementById('tax-rate').value) || 0,
                subtotal: 0,
                total: 0,
                currency: document.getElementById('currency').value || 'USD',
            };

            let subtotal = 0;
            document.querySelectorAll('.item-row').forEach(row => {
                const description = row.querySelector('.description').value;
                const quantity = parseFloat(row.querySelector('.quantity').value) || 0;
                const price = parseFloat(row.querySelector('.price').value) || 0;
                invoiceData.items.push({ description, quantity, price });
                subtotal += quantity * price;
            });

            invoiceData.subtotal = subtotal;
            invoiceData.total = subtotal * (1 + invoiceData.taxRate / 100);

            const showToast = (el, message) => {
                el.textContent = message;
                el.classList.remove('opacity-0', '-translate-y-2');
                el.classList.add('opacity-100', 'translate-y-0');
                setTimeout(() => {
                    el.classList.remove('opacity-100', 'translate-y-0');
                    el.classList.add('opacity-0', '-translate-y-2');
                }, 3000);
            };

            const resetForm = () => {
                // keep a valid option selected (setting value='' leaves the <select> invalid)
                document.getElementById('invoice-type').selectedIndex = 0;
                ['company-name', 'company-address', 'company-city', 'company-phone', 'company-email',
                 'client-name', 'client-address', 'client-city', 'client-phone', 'client-email',
                 'payment-type', 'notes'].forEach((id) => { document.getElementById(id).value = ''; });
            };

           fetch('/pdf/invoice-generate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(invoiceData)
            })
            .then(async res => {
                if (!res.ok) {
                    let message = 'Something went wrong, please try again.';
                    try {
                        const errData = await res.json();
                        if (errData.errors && errData.errors.length) {
                            const msgs = errData.errors.map((err) => err.msg);
                            const shown = msgs.slice(0, 3);
                            if (msgs.length > 3) shown.push(`…and ${msgs.length - 3} more`);
                            message = shown.join('\n');
                        } else if (errData.error) {
                            message = errData.error;
                        }
                    } catch (e) {
                        // response body was not JSON; keep the generic message
                    }
                    throw new Error(message);
                }
                return res.blob();
            })
            .then(blob => {
                const url = window.URL.createObjectURL(blob);
                const preview = window.open(url, '_blank');

                if (preview) {
                    // Give the new tab time to start loading the blob.
                    setTimeout(() => window.URL.revokeObjectURL(url), 60000);
                    showToast(document.getElementById('notification-toast'), 'Invoice opened in a new tab');
                } else {
                    // Popup blocked — fall back to a direct download.
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = 'invoice.pdf';
                    a.click();
                    window.URL.revokeObjectURL(url);
                    showToast(document.getElementById('notification-toast'), 'Invoice generated successfully');
                }
                resetForm();
            })
            .catch(err => {
                showToast(document.getElementById('notification-toast-error'), (err && err.message) ? err.message : 'Something went wrong, please try again.');
            })
            .finally(() => {
                submitBtn.textContent = 'Submit for Processing';
                submitBtn.disabled = false;
                submitBtn.removeAttribute('aria-busy');
            });
        });

        // --- Initial Setup ---
        addNewItem();
        document.getElementById('invoice-date').valueAsDate = new Date();
        updateTotals();
    });    

    </script> 
</body>
</html>
