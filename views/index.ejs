<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invoice Generator Pro</title>
    
    <!-- Apply theme before paint to avoid FOUC -->
    <script>
        try {
            const storedTheme = localStorage.getItem('pdfinvoice-theme');
            // Guard matchMedia separately: if it's missing or throws, the
            // stored theme must still be applied.
            let prefersDark = false;
            try {
                prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            } catch (e) {}
            const useDark = storedTheme ? storedTheme === 'dark' : prefersDark;
            if (useDark) {
                document.documentElement.classList.add('dark');
            }
        } catch (e) {}
    </script>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
        };
    </script>

    <!-- Google Fonts: Inter & Roboto Slab -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@400;700&display=swap" rel="stylesheet">


    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        /* Native controls (date pickers, select dropdowns, scrollbars) follow the theme */
        html.dark {
            color-scheme: dark;
        }

        .gradient-text {
            background-image: linear-gradient(to right, #434d5f, #2d3748);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        .dark .gradient-text {
            background-image: linear-gradient(to right, #cbd5e1, #e2e8f0);
        }

        .invoice-input {
            background-color: #ffffff;
            border: 1px solid #e2e8f0;
            transition: all 0.3s ease;
        }
        .invoice-input:focus {
            box-shadow: 0 0 0 3px rgba(66, 153, 225, 0.4);
            border-color: #4299e1; /* A professional blue */
        }
        /* One override covers every static field and the dynamically added item rows */
        .dark .invoice-input {
            background-color: #1e293b; /* slate-800 */
            border-color: #334155; /* slate-700 */
            color: #e2e8f0; /* slate-200 */
        }
        .dark .invoice-input::placeholder {
            color: #94a3b8; /* slate-400 */
        }
        .dark .invoice-input:focus {
            border-color: #60a5fa; /* blue-400, keeps the ring visible on dark */
        }

        /* Visible focus ring for keyboard navigation (WCAG 2.4.7) */
        .invoice-input:focus-visible,
        button:focus-visible {
            outline: 2px solid #2563eb;
            outline-offset: 2px;
        }

        #notification-toast {
             transition: opacity 0.3s, transform 0.3s;
        }

        /* EN/FR switcher: the active state follows aria-pressed, which applyLang()
           toggles on click and on load (localStorage may restore 'fr'). */
        .lang-btn { transition: background-color 0.2s, border-color 0.2s, color 0.2s; }
        .lang-btn[aria-pressed="true"] { background-color: #2563eb; border-color: transparent; color: #fff; }
        .lang-btn[aria-pressed="false"] { background-color: #fff; border-color: #cbd5e1; color: #475569; }
        /* Tailwind's stylesheet is injected after this block, so the dark-mode
           variants need the extra specificity to win the tie. */
        html.dark .lang-btn[aria-pressed="true"] { background-color: #2563eb; border-color: transparent; color: #fff; }
        html.dark .lang-btn[aria-pressed="false"] { background-color: #1e293b; border-color: #334155; color: #e2e8f0; }
    </style>
</head>
<body class="bg-slate-100 dark:bg-slate-900 text-slate-800 dark:text-slate-200">

    <div class="container mx-auto p-4 lg:p-8">
        <!-- Header Section -->
        <header class="text-center mb-10">
            <h1 data-i18n="ui.title" class="text-4xl md:text-5xl font-extrabold gradient-text">Professional Document Builder</h1>
            <p data-i18n="ui.subtitle" class="text-slate-500 dark:text-slate-400 mt-3 text-base md:text-lg">Fill the form to generate your document.</p>
            <div class="flex justify-center gap-2 mt-4 items-center" role="group" aria-label="Language and theme">
                <button type="button" data-lang="en" data-i18n-aria="ui.langEnAria" aria-label="Switch to English" aria-pressed="true" class="lang-btn px-3 py-1 rounded-md text-sm font-semibold bg-blue-600 text-white">EN</button>
                <button type="button" data-lang="fr" data-i18n-aria="ui.langFrAria" aria-label="Switch to French" aria-pressed="false" class="lang-btn px-3 py-1 rounded-md text-sm font-semibold bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 text-slate-600 dark:text-slate-200">FR</button>
                <button type="button" id="theme-toggle" aria-label="Toggle dark mode" aria-pressed="false" class="ml-2 p-2 rounded-md bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 text-slate-600 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                    <svg id="theme-icon-sun" class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
                    </svg>
                    <svg id="theme-icon-moon" class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
                    </svg>
                </button>
            </div>
        </header>

        <!-- Main Content Area: Form -->
        <div class="max-w-4xl mx-auto">
            <form id="invoice-form" class="bg-white dark:bg-slate-800 dark:border dark:border-slate-700 p-6 md:p-8 rounded-2xl shadow-lg">
                 <!-- Invoice Type -->
                <section class="mb-8">
                    <h3 data-i18n="ui.docTypeHeading" class="text-lg font-semibold text-slate-700 dark:text-slate-300 mb-2">Document Type</h3>
                    <label for="invoice-type" data-i18n="ui.docTypeLabel" class="sr-only">Document type</label>
                    <select id="invoice-type" class="w-full p-2.5 rounded-md invoice-input">
                        <option value="SERVICE INVOICE" data-i18n="ui.docTypeService">Service Invoice</option>
                        <option value="PRODUCT INVOICE" data-i18n="ui.docTypeProduct">Product Invoice</option>
                        <option value="QUOTE" data-i18n="ui.docTypeQuote">Quote</option>
                        <option value="RECEIPT" data-i18n="ui.docTypeReceipt">Receipt</option>
                    </select>
                </section>
                
                <!-- Company and Client Details -->
                <section class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6 mb-8">
                    <div>
                        <h3 data-i18n="ui.from" class="text-lg font-semibold text-slate-700 dark:text-slate-300 mb-2">From</h3>
                        <label for="company-name" data-i18n="ui.companyNameLabel" class="sr-only">Company name</label>
                        <input id="company-name" type="text" data-i18n-ph="ui.companyNamePh" placeholder="Your Company Name" required class="w-full p-2.5 rounded-md invoice-input">
                        <label for="company-address" data-i18n="ui.companyAddressLabel" class="sr-only">Company address</label>
                        <textarea id="company-address" data-i18n-ph="ui.companyAddressPh" placeholder="Your Address..." class="w-full p-2.5 mt-2 rounded-md invoice-input" rows="2"></textarea>
                        <label for="company-phone" data-i18n="ui.companyPhoneLabel" class="sr-only">Company phone</label>
                        <input id="company-phone" type="text" data-i18n-ph="ui.companyPhonePh" placeholder="Your Company phone" class="w-full p-2.5 rounded-md invoice-input">
                        <label for="company-city" data-i18n="ui.companyCityLabel" class="sr-only">Company city</label>
                        <input id="company-city" type="text" data-i18n-ph="ui.companyCityPh" placeholder="Your company city" class="w-full p-2.5 rounded-md invoice-input">
                        <label for="company-email" data-i18n="ui.companyEmailLabel" class="sr-only">Company email</label>
                        <input id="company-email" type="text" data-i18n-ph="ui.companyEmailPh" placeholder="Your company email" class="w-full p-2.5 rounded-md invoice-input">
                    </div>
                    <div>
                        <h3 data-i18n="ui.billTo" class="text-lg font-semibold text-slate-700 dark:text-slate-300 mb-2">Bill To</h3>
                        <label for="client-name" data-i18n="ui.clientNameLabel" class="sr-only">Client name</label>
                        <input id="client-name" type="text" data-i18n-ph="ui.clientNamePh" placeholder="Client's Company Name" required class="w-full p-2.5 rounded-md invoice-input">
                        <label for="client-address" data-i18n="ui.clientAddressLabel" class="sr-only">Client address</label>
                        <textarea id="client-address" data-i18n-ph="ui.clientAddressPh" placeholder="Client's Address..." class="w-full p-2.5 mt-2 rounded-md invoice-input" rows="2"></textarea>
                        <label for="client-phone" data-i18n="ui.clientPhoneLabel" class="sr-only">Client phone</label>
                        <input id="client-phone" type="text" data-i18n-ph="ui.clientPhonePh" placeholder="Your client phone" class="w-full p-2.5 rounded-md invoice-input">
                        <label for="client-city" data-i18n="ui.clientCityLabel" class="sr-only">Client city</label>
                        <input id="client-city" type="text" data-i18n-ph="ui.clientCityPh" placeholder="Your client city" class="w-full p-2.5 rounded-md invoice-input">
                        <label for="client-email" data-i18n="ui.clientEmailLabel" class="sr-only">Client email</label>
                        <input id="client-email" type="text" data-i18n-ph="ui.clientEmailPh" placeholder="Your client email" class="w-full p-2.5 rounded-md invoice-input">
                    </div>
                </section>

                <!-- Invoice Metadata -->
                <section class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
                    <div>
                        <label for="invoice-date" data-i18n="ui.dateLabel" class="block text-sm font-medium text-slate-500 dark:text-slate-400 mb-1">Date</label>
                        <input id="invoice-date" type="date" required class="w-full p-2.5 rounded-md invoice-input text-slate-500 dark:text-slate-400">
                    </div>
                    <div>
                        <label for="due-date" data-i18n="ui.dueDateLabel" class="block text-sm font-medium text-slate-500 dark:text-slate-400 mb-1">Due Date</label>
                        <input id="due-date" type="date" class="w-full p-2.5 rounded-md invoice-input text-slate-500 dark:text-slate-400">
                    </div>
                    <div>
                        <label for="currency" data-i18n="ui.currencyLabel" class="block text-sm font-medium text-slate-500 dark:text-slate-400 mb-1">Currency</label>
                        <select name="" id="currency" required class="w-full p-2.5 rounded-md invoice-input">
                            <option value="USD">USD</option>
                            <option value="MAD">MAD</option>
                            <option value="EUR">EUR</option>
                            <option value="JPY">JPY</option>
                            <option value="GBP">GBP</option>
                        </select>
                    </div>
                </section>

                <!-- Invoice Items Table -->
                <section class="mb-8">
                    <h3 data-i18n="ui.itemsHeading" class="text-lg font-semibold text-slate-700 dark:text-slate-300 mb-2">Items (max: 15)</h3>
                    <div class="overflow-x-auto">
                        <table class="w-full">
                            <thead class="border-b border-slate-200 dark:border-slate-700">
                                <tr class="text-sm text-slate-600 dark:text-slate-400">
                                    <th data-i18n="ui.tableDescription" class="p-2 font-semibold w-1/2 text-left">Description</th>
                                    <th data-i18n="ui.tableQty" class="p-2 font-semibold w-1/6 text-center">Qty</th>
                                    <th data-i18n="ui.tablePrice" class="p-2 font-semibold w-1/4 text-center">Price</th>
                                    <th class="p-2"><span data-i18n="ui.actions" class="sr-only">Actions</span></th>
                                </tr>
                            </thead>
                            <tbody id="invoice-items"></tbody>
                        </table>
                    </div>
                    <div class="mt-4 flex items-center gap-3">
                        <button type="button" id="add-item-btn" class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 font-semibold flex items-center disabled:opacity-50 disabled:cursor-not-allowed">
                            <svg class="w-5 h-5 mr-1" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
                            <span data-i18n="ui.addItem">Add Item</span>
                        </button>
                        <span id="items-limit-hint" data-i18n="ui.itemsLimitHint" class="hidden text-sm text-amber-600 dark:text-amber-400">Maximum of 15 items reached.</span>
                    </div>
                </section>
                
                 <!-- Totals Section -->
                <section class="flex justify-end mb-8">
                     <div class="w-full max-w-xs space-y-2">
                            <div class="flex justify-between text-slate-600 dark:text-slate-400">
                                <span data-i18n="ui.subtotal">Subtotal</span>
                                <span id="subtotal">$0.00</span>
                            </div>
                            <div class="flex justify-between items-center text-slate-600 dark:text-slate-400">
                                <label for="tax-rate" data-i18n="ui.taxRate">Tax (%)</label>
                                <input id="tax-rate" type="number" value="0" min="0" max="100" required class="w-20 p-1 text-right rounded-md invoice-input">
                            </div>
                            <hr class="border-slate-300 dark:border-slate-700">
                            <div class="flex justify-between font-bold text-xl text-slate-800 dark:text-slate-100"><span data-i18n="ui.total" class="">Total</span><span id="total-amount">$0.00</span></div>
                        </div>
                </section>

                 <!-- Payment and Notes -->
                <section class="grid grid-cols-1 md:grid-cols-2 gap-x-8">
                    <div>
                        <h3 data-i18n="ui.paymentHeading" class="text-lg font-semibold text-slate-700 dark:text-slate-300 mb-2">Payment Type</h3>
                        <label for="payment-type" data-i18n="ui.paymentLabel" class="sr-only">Payment type</label>
                        <textarea id="payment-type" data-i18n-ph="ui.paymentPh" placeholder="e.g., Bank Transfer, Credit Card, Net 30" class="w-full p-2.5 rounded-md invoice-input" rows="4"></textarea>
                    </div>
                     <div>
                        <h3 data-i18n="ui.notesHeading" class="text-lg font-semibold text-slate-700 dark:text-slate-300 mb-2">Notes</h3>
                        <label for="notes" data-i18n="ui.notesLabel" class="sr-only">Notes</label>
                        <textarea id="notes" data-i18n-ph="ui.notesPh" placeholder="Thank you for your business!" class="w-full p-2.5 rounded-md invoice-input" rows="4"></textarea>
                    </div>
                </section>

                <!-- Submit Button -->
                <section class="text-center mt-10">
                    <button id="submit-btn" class="bg-blue-600 text-white font-bold py-3 px-10 rounded-lg text-lg hover:bg-blue-700 transition-colors">
                        <span id="submit-btn-label" data-i18n="ui.submit">Submit for Processing</span>
                    </button>
                </section>
            </form>
        </div>
    </div>
    
    <div id="notification-toast" role="status" aria-live="polite" class="fixed top-5 right-5 bg-green-600 text-white py-3 px-6 rounded-lg shadow-lg opacity-0 transform -translate-y-2">
        data sent
    </div>
     <div id="notification-toast-error" role="alert" aria-live="assertive" class="fixed top-5 left-5 bg-red-600 text-white py-3 px-6 rounded-lg shadow-lg whitespace-pre-line opacity-0 transform -translate-y-2">
        Something went wrong, please try again.
    </div>

     <script src="/i18n.js"></script>
     <script>
        document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('invoice-form');
        const addItemBtn = document.getElementById('add-item-btn');
        const invoiceItemsContainer = document.getElementById('invoice-items');
        const submitBtn = document.getElementById('submit-btn');
        const submitBtnLabel = document.getElementById('submit-btn-label');
        const selectTags = document.getElementById('currency');

        // --- i18n (chunk 5.3): same dictionaries the server uses for PDFs ---
        const I18N = window.I18N || {};
        let currentLang = 'en';
        try { if (localStorage.getItem('pdfinvoice-lang') === 'fr') currentLang = 'fr'; } catch (e) {}

        const tUi = (key, params) => {
            let text = (I18N[currentLang] && I18N[currentLang][key])
                || (I18N.en && I18N.en[key])
                || '';
            if (params) {
                for (const name in params) {
                    text = text.split('{' + name + '}').join(String(params[name]));
                }
            }
            return text;
        };

        const applyLang = (lang) => {
            currentLang = lang;
            try { localStorage.setItem('pdfinvoice-lang', lang); } catch (e) {}
            // Only overwrite when a translation exists — the hardcoded English
            // text in the markup stays as the fallback if /i18n.js is missing.
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const text = tUi(el.getAttribute('data-i18n'));
                if (text) el.textContent = text;
            });
            document.querySelectorAll('[data-i18n-ph]').forEach(el => {
                const text = tUi(el.getAttribute('data-i18n-ph'));
                if (text) el.setAttribute('placeholder', text);
            });
            document.querySelectorAll('[data-i18n-aria]').forEach(el => {
                const text = tUi(el.getAttribute('data-i18n-aria'));
                if (text) el.setAttribute('aria-label', text);
            });
            document.querySelectorAll('.lang-btn').forEach(btn => {
                btn.setAttribute('aria-pressed', String(btn.dataset.lang === lang));
            });
            document.documentElement.lang = lang;
            document.title = tUi('ui.pageTitle') || document.title;
        };

        document.querySelectorAll('.lang-btn').forEach(btn => {
            btn.addEventListener('click', () => applyLang(btn.dataset.lang));
        });


        // --- Theme (dark mode) ---
        // The head script already applied the class before first paint; here we
        // only wire the toggle, persistence, and follow the OS when the user
        // has made no explicit choice.
        const themeToggle = document.getElementById('theme-toggle');
        const THEME_KEY = 'pdfinvoice-theme';
        const prefersDarkQuery = typeof window.matchMedia === 'function'
            ? window.matchMedia('(prefers-color-scheme: dark)')
            : null;

        const getStoredTheme = () => {
            try { return localStorage.getItem(THEME_KEY); } catch (e) { return null; }
        };

        const applyTheme = (theme) => {
            const isDark = theme === 'dark';
            document.documentElement.classList.toggle('dark', isDark);
            themeToggle.setAttribute('aria-pressed', String(isDark));
        };

        // Sync the button with the theme the head script picked.
        applyTheme(document.documentElement.classList.contains('dark') ? 'dark' : 'light');

        themeToggle.addEventListener('click', () => {
            const next = document.documentElement.classList.contains('dark') ? 'light' : 'dark';
            try { localStorage.setItem(THEME_KEY, next); } catch (e) {}
            applyTheme(next);
        });

        // No explicit choice yet -> mirror OS changes live.
        if (prefersDarkQuery && !getStoredTheme() && typeof prefersDarkQuery.addEventListener === 'function') {
            prefersDarkQuery.addEventListener('change', (e) => applyTheme(e.matches ? 'dark' : 'light'));
        }


        // --- Totals state + rendering (single source of truth) ---
        let subtotalNumber = 0;
        let totalNumber = 0;

        // Locale per currency, mirroring the server-side map (chunk 4.6).
        const CURRENCY_LOCALES = { USD: 'en-US', MAD: 'fr-MA', EUR: 'de-DE', JPY: 'ja-JP', GBP: 'en-GB' };

        const formatCurrency = (value, code) => {
            try {
                return new Intl.NumberFormat(CURRENCY_LOCALES[code] || 'en-US', {
                    style: 'currency',
                    currency: code,
                }).format(value);
            } catch (e) {
                // Unknown code — never let Intl crash the form.
                return `${value.toFixed(2)} ${code}`;
            }
        };

        const renderTotals = () => {
            const code = selectTags.value;
            document.getElementById('subtotal').textContent = formatCurrency(subtotalNumber, code);
            document.getElementById('total-amount').textContent = formatCurrency(totalNumber, code);
        };

        selectTags.addEventListener('change', renderTotals);

        // --- Core Functions ---
        const MAX_ITEMS = 15;

        const updateAddItemState = () => {
            const atLimit = document.querySelectorAll('.item-row').length >= MAX_ITEMS;
            addItemBtn.disabled = atLimit;
            addItemBtn.classList.toggle('opacity-50', atLimit);
            document.getElementById('items-limit-hint').classList.toggle('hidden', !atLimit);
        };

        const addNewItem = () => {
            if (document.querySelectorAll('.item-row').length >= MAX_ITEMS) return;
            const itemRow = document.createElement('tr');
            itemRow.classList.add('item-row');
            itemRow.innerHTML = `
                <td class="p-2"><input type="text" data-i18n-ph="ui.itemDescriptionPh" placeholder="Item description" maxlength="54" data-i18n-aria="ui.itemDescriptionAria" aria-label="Item description" class="description w-full p-2 rounded-md invoice-input"></td>
                <td class="p-2"><input type="number" value="1" min="1" data-i18n-aria="ui.itemQuantityAria" aria-label="Quantity" class="quantity w-full p-2 text-center rounded-md invoice-input"></td>
                <td class="p-2"><input type="number" value="0.00" min="0" step="0.01" data-i18n-aria="ui.itemPriceAria" aria-label="Price" class="price w-full p-2 text-center rounded-md invoice-input"></td>
                <td class="p-2 text-center">
                    <button type="button" data-i18n-aria="ui.removeItemAria" aria-label="Remove item" class="remove-item-btn text-slate-400 dark:text-slate-500 hover:text-red-500 dark:hover:text-red-400 transition-colors">
                        <svg class="w-5 h-5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                    </button>
                </td>
            `;
            invoiceItemsContainer.appendChild(itemRow);
            applyLang(currentLang); // translate the freshly added row
            updateTotals(); // Call updateTotals after adding
            updateAddItemState();
        };

        const updateTotals = () => {
            let subtotal = 0;
            document.querySelectorAll('.item-row').forEach(row => {
                const qty = parseFloat(row.querySelector('.quantity').value) || 0;
                const price = parseFloat(row.querySelector('.price').value) || 0;
                subtotal += qty * price;
            });

            const taxRate = parseFloat(document.getElementById('tax-rate').value) || 0;
            const taxAmount = subtotal * (taxRate / 100);

            subtotalNumber = subtotal;
            totalNumber = subtotal + taxAmount;

            renderTotals();
        };

        // --- Event Listeners ---
        form.addEventListener('input', (e) => {
             // Update totals on any input change within the form
            if(e.target.matches('.quantity, .price, #tax-rate')) {
                updateTotals();
            }
        });
        
        addItemBtn.addEventListener('click', addNewItem);



        invoiceItemsContainer.addEventListener('click', (e) => {
            if (e.target.closest('.remove-item-btn')) {
                e.target.closest('.item-row').remove();
                updateTotals(); // Call updateTotals after removing
                updateAddItemState();
            }
        });

        form.addEventListener('submit', (e) => {
            e.preventDefault(); // stop native form submission (page navigation)
            submitBtnLabel.textContent = tUi('ui.processing');
            submitBtn.disabled = true;
            submitBtn.setAttribute('aria-busy', 'true');

            const invoiceData = {
                documentType: document.getElementById('invoice-type').value,
                company: { name: document.getElementById('company-name').value, address: document.getElementById('company-address').value,
                phone: document.getElementById('company-phone').value, city: document.getElementById('company-city').value, email: document.getElementById('company-email').value},
                client: { name: document.getElementById('client-name').value, address: document.getElementById('client-address').value, 
                phone: document.getElementById('client-phone').value, city: document.getElementById('client-city').value, email: document.getElementById('client-email').value},
                issueDate: document.getElementById('invoice-date').value,
                dueDate: document.getElementById('due-date').value,
                items: [],
                paymentType: document.getElementById('payment-type').value,
                notes: document.getElementById('notes').value,
                taxRate: parseFloat(document.getElementById('tax-rate').value) || 0,
                subtotal: 0,
                total: 0,
                currency: document.getElementById('currency').value || 'USD',
                language: currentLang,
            };

            let subtotal = 0;
            document.querySelectorAll('.item-row').forEach(row => {
                const description = row.querySelector('.description').value;
                const quantity = parseFloat(row.querySelector('.quantity').value) || 0;
                const price = parseFloat(row.querySelector('.price').value) || 0;
                invoiceData.items.push({ description, quantity, price });
                subtotal += quantity * price;
            });

            invoiceData.subtotal = subtotal;
            invoiceData.total = subtotal * (1 + invoiceData.taxRate / 100);

            const showToast = (el, message) => {
                el.textContent = message;
                el.classList.remove('opacity-0', '-translate-y-2');
                el.classList.add('opacity-100', 'translate-y-0');
                setTimeout(() => {
                    el.classList.remove('opacity-100', 'translate-y-0');
                    el.classList.add('opacity-0', '-translate-y-2');
                }, 3000);
            };

            const resetForm = () => {
                // keep a valid option selected (setting value='' leaves the <select> invalid)
                document.getElementById('invoice-type').selectedIndex = 0;
                ['company-name', 'company-address', 'company-city', 'company-phone', 'company-email',
                 'client-name', 'client-address', 'client-city', 'client-phone', 'client-email',
                 'payment-type', 'notes'].forEach((id) => { document.getElementById(id).value = ''; });
            };

           fetch('/pdf/invoice-generate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(invoiceData)
            })
            .then(async res => {
                if (!res.ok) {
                    let message = tUi('ui.errorGeneric');
                    try {
                        const errData = await res.json();
                        if (errData.errors && errData.errors.length) {
                            const msgs = errData.errors.map((err) => err.msg);
                            const shown = msgs.slice(0, 3);
                            if (msgs.length > 3) shown.push(tUi('ui.errorMore', { count: msgs.length - 3 }));
                            message = shown.join('\n');
                        } else if (errData.error) {
                            message = errData.error;
                        }
                    } catch (e) {
                        // response body was not JSON; keep the generic message
                    }
                    throw new Error(message);
                }
                return res.blob();
            })
            .then(blob => {
                const url = window.URL.createObjectURL(blob);
                const preview = window.open(url, '_blank');

                if (preview) {
                    // Give the new tab time to start loading the blob.
                    setTimeout(() => window.URL.revokeObjectURL(url), 60000);
                    showToast(document.getElementById('notification-toast'), tUi('ui.toastPreview'));
                } else {
                    // Popup blocked — fall back to a direct download.
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = 'invoice.pdf';
                    a.click();
                    window.URL.revokeObjectURL(url);
                    showToast(document.getElementById('notification-toast'), tUi('ui.toastDownloaded'));
                }
                resetForm();
            })
            .catch(err => {
                showToast(document.getElementById('notification-toast-error'), (err && err.message) ? err.message : tUi('ui.errorGeneric'));
            })
            .finally(() => {
                applyLang(currentLang); // restore the translated button label
                submitBtn.disabled = false;
                submitBtn.removeAttribute('aria-busy');
            });
        });

        // --- Initial Setup ---
        addNewItem();
        applyLang(currentLang);
        document.getElementById('invoice-date').valueAsDate = new Date();
        updateTotals();
    });    

    </script> 
</body>
</html>
