<header class="sticky top-0 z-20 border-b border-rule bg-paper/95 backdrop-blur">
    <div class="mx-auto flex max-w-5xl items-center gap-4 px-4 py-3 lg:px-8">
        <h1 data-i18n="ui.title" class="display text-lg sm:text-xl flex-1 min-w-0 truncate">Professional Document Builder</h1>

        <div class="flex items-center gap-2" role="group" aria-label="Language and theme">
            <button type="button" data-lang="en" data-i18n-aria="ui.langEnAria" aria-label="Switch to English" aria-pressed="true" class="lang-btn rounded-md border px-2.5 py-1 text-xs font-semibold">EN</button>
            <button type="button" data-lang="fr" data-i18n-aria="ui.langFrAria" aria-label="Switch to French" aria-pressed="false" class="lang-btn rounded-md border px-2.5 py-1 text-xs font-semibold">FR</button>
            <button type="button" id="theme-toggle" aria-label="Toggle dark mode" aria-pressed="false" class="rounded-md border border-field-border bg-field p-1.5 text-ink-soft transition-colors hover:text-ink">
                <svg id="theme-icon-sun" class="hidden h-4 w-4 dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
                </svg>
                <svg id="theme-icon-moon" class="block h-4 w-4 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
                </svg>
            </button>
        </div>
    </div>
</header>
