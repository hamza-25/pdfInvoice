<header class="text-center mb-10">
    <h1 data-i18n="ui.title" class="text-4xl md:text-5xl font-extrabold gradient-text">Professional Document Builder</h1>
    <p data-i18n="ui.subtitle" class="text-slate-500 dark:text-slate-400 mt-3 text-base md:text-lg">Fill the form to generate your document.</p>
    <div class="flex justify-center gap-2 mt-4 items-center" role="group" aria-label="Language and theme">
        <button type="button" data-lang="en" data-i18n-aria="ui.langEnAria" aria-label="Switch to English" aria-pressed="true" class="lang-btn px-3 py-1 rounded-md text-sm font-semibold bg-blue-600 text-white">EN</button>
        <button type="button" data-lang="fr" data-i18n-aria="ui.langFrAria" aria-label="Switch to French" aria-pressed="false" class="lang-btn px-3 py-1 rounded-md text-sm font-semibold bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 text-slate-600 dark:text-slate-200">FR</button>
        <button type="button" id="theme-toggle" aria-label="Toggle dark mode" aria-pressed="false" class="ml-2 p-2 rounded-md bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 text-slate-600 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
            <svg id="theme-icon-sun" class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
            <svg id="theme-icon-moon" class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
            </svg>
        </button>
    </div>
</header>
